[Unit]
Description=Edge Webhook Proxy agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edge-proxy
Group=edge-proxy
WorkingDirectory=/opt/edge-proxy
EnvironmentFile=/etc/edge-proxy/agent.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
# The agent finishes open requests for up to 10 s after SIGTERM.
TimeoutStopSec=15

# Hardening: the agent only needs the network and its writable config directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/edge-proxy
MemoryMax=512M

[Install]
WantedBy=multi-user.target
