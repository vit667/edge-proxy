# /etc/edge-proxy/agent.env — owner root:edge-proxy, mode 640.
# Generate tokens: openssl rand -hex 32

# Unique per server: it names the node in the panel and marks requests to stop forwarding loops.
NODE_ID=odora-1

# Token for direct API calls through the proxy (x-edge-token). Telegram does not use it.
EDGE_TOKEN=
# Control panel / admin API token.
ADMIN_TOKEN=

CONFIG_PATH=/var/lib/edge-proxy/config.json

# Both ports stay on loopback: nginx talks to 8787, the panel is reached through an SSH tunnel.
HOST=127.0.0.1
PORT=8787
UI_HOST=127.0.0.1
UI_PORT=8788

# nginx terminates TLS and appends the client address to X-Forwarded-For.
TRUST_PROXY=1
PROXY_HTTPS=1

# Telegram (A-Z a-z 0-9 _ -, up to 256 characters): openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# From @BotFather. Optional: enables "Проверить" / "Зарегистрировать" in the panel.
TELEGRAM_BOT_TOKEN=

# PostgreSQL monitoring/control (later, when replication is set up).
# PGUSER=edge_monitor
# PGPASSWORD=
# PG_ADMIN_USER=
# PG_ADMIN_PASSWORD=
